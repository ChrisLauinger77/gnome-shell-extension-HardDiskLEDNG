<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="harddiskled@bijidroid.gmail.com">
  <schema path="/org/gnome/shell/extensions/harddiskled/" id="org.gnome.shell.extensions.harddiskled">
      <key name="mode" type="i">
        <range min="0" max="10" />
        <default>0</default>
        <summary>Display mode</summary>
        <description>Currently active display mode (0-7).</description>
      </key>
      <key name="defaultmode" type="i">
        <range min="-1" max="7" />
        <default>-1</default>
        <summary>Default display mode</summary>
        <description>Mode applied when the extension is loaded. -1 (None) keeps the last used mode.</description>
      </key>
      <key name="led-color" type="s">
        <default>'#00ff00'</default>
        <summary>LED color</summary>
        <description>Color of the activity LED as a CSS color string.</description>
      </key>
  </schema>
</schemalist>
