#: harddiskledNG@lauinger-clan.de/schemas/org.gnome.shell.extensions.harddiskled.gschema.xml:7
msgid "Display mode"
msgstr "Anzeigemodus"

#: harddiskledNG@lauinger-clan.de/schemas/org.gnome.shell.extensions.harddiskled.gschema.xml:8
msgid "Currently active display mode (0-7)."
msgstr "Derzeit aktiver Anzeigemodus (0–7)."

#: harddiskledNG@lauinger-clan.de/schemas/org.gnome.shell.extensions.harddiskled.gschema.xml:13
msgid "Default display mode"
msgstr "Standardanzeigemodus"

#: harddiskledNG@lauinger-clan.de/schemas/org.gnome.shell.extensions.harddiskled.gschema.xml:14
msgid ""
"Mode applied when the extension is loaded. -1 (None) keeps the last used "
"mode."
msgstr ""
"Modus beim Laden der Erweiterung. -1 (Keiner) behält den zuletzt verwendeten "
"Modus bei."

#: harddiskledNG@lauinger-clan.de/schemas/org.gnome.shell.extensions.harddiskled.gschema.xml:18
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:66
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:84
msgid "LED color"
msgstr "LED-Farbe"

#: harddiskledNG@lauinger-clan.de/schemas/org.gnome.shell.extensions.harddiskled.gschema.xml:19
msgid "Color of the activity LED as a CSS color string."
msgstr "Farbe der Aktivitäts-LED als CSS-Farbwert."

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:7
msgid "General"
msgstr "Allgemein"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:12
msgid "Display"
msgstr "Anzeige"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:13
msgid ""
"Choose what is shown in the top panel. Clicking the indicator also cycles "
"through the modes."
msgstr ""
"Wählen Sie aus, was in der oberen Leiste angezeigt wird. Ein Klick auf die "
"Anzeige wechselt zum nächsten Modus."

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:17
msgid "Mode"
msgstr "Modus"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:18
msgid "Currently active display mode"
msgstr "Derzeit aktiver Anzeigemodus"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:22
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:44
msgid "Small LED, speed and icon"
msgstr "Kleine LED, Übertragungsrate und Symbol"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:23
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:45
msgid "Large LED, speed and icon"
msgstr "Große LED, Übertragungsrate und Symbol"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:24
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:46
msgid "Small LED and icon"
msgstr "Kleine LED und Symbol"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:25
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:47
msgid "Large LED and icon"
msgstr "Große LED und Symbol"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:26
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:48
msgid "Small LED and speed"
msgstr "Kleine LED und Übertragungsrate"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:27
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:49
msgid "Speed only"
msgstr "Nur Übertragungsrate"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:28
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:50
msgid "Small LED only"
msgstr "Nur kleine LED"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:29
#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:51
msgid "Large LED only"
msgstr "Nur große LED"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:38
msgid "Default mode"
msgstr "Standardmodus"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:39
msgid ""
"Mode applied when the extension is loaded. “None” keeps the last used mode."
msgstr ""
"Modus beim Laden der Erweiterung. „Keiner“ behält den zuletzt verwendeten "
"Modus bei."

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:43
msgid "None"
msgstr "Keiner"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:62
msgid "Appearance"
msgstr "Erscheinungsbild"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:67
msgid "Color of the activity LED"
msgstr "Farbe der Aktivitäts-LED"

#: harddiskledNG@lauinger-clan.de/ui/prefs.ui:72
msgid "Reset to default"
msgstr "Auf Standardwert zurücksetzen"
